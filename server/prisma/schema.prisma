// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


enum SubscriptionTier {
  FREE
  PLUS
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
}

enum AccrualType {
  SIMPLE
  COMPOUND
}

enum RiskBand {
  SAFE
  MODERATE
  HIGH_STRESS
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  email        String        @unique
  passwordHash String
  name         String?
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  plans        Plan[]
  subscription Subscription?
  payments     Payment[]

  @@map("users")
}

model Subscription {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  userId             String             @unique @db.ObjectId
  tier               SubscriptionTier
  status             SubscriptionStatus
  razorpaySubId      String             @unique
  razorpayCustomerId String?
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  cancelledAt        DateTime?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]

  @@map("subscriptions")
}

model PaymentEvent {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  razorpayEventId String   @unique
  eventType       String
  rawPayload      Json
  userId          String?  @db.ObjectId
  createdAt       DateTime @default(now())

  @@map("payment_events")
}

model Plan {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  userId             String      @db.ObjectId
  name               String
  // Academic profile
  degree             String
  institution        String
  city               String
  durationYears      Int
  tuitionCostPerYear Float
  livingCostPerYear  Float
  educationInflation Float       @default(8)
  generalInflation   Float       @default(6)
  // Loan configuration
  principal          Float
  interestRate       Float       // annual %
  moratoriumMonths   Int
  accrualType        AccrualType @default(COMPOUND)
  repaymentMonths    Int         @default(120) // 10 years default
  // Results (denormalised for fast read)
  computedResults    Json?
  // Relations
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskReport         RiskReport?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@map("plans")
}

model RiskReport {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  planId                String   @unique @db.ObjectId
  foirPercent           Float
  riskBand              RiskBand
  aiSummary             String?
  mitigationSuggestions String?  // JSON array stored as text
  salaryRangeMin        Float?
  salaryRangeMax        Float?
  generatedAt           DateTime @default(now())
  plan                  Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("risk_reports")
}

model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  @@map("admins")
}

model Payment {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId     String?      @db.ObjectId
  userId             String?      @db.ObjectId
  razorpayPaymentId  String       @unique
  amount             Float
  currency           String       @default("INR")
  status             String       // "Success" or "Failed"
  paymentDate        DateTime     @default(now())
  createdAt          DateTime     @default(now())

  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("payments")
}
